%======================================================%
% Properties of reducible expressions
%======================================================%

LF prefs : (obj → proc) → (obj → proc) → type =
| prfs : ({x:obj} pref x (P x)) → ({y:obj} pref y (Q y)) → prefs P Q;

% If NotRedex((νxy)(P ‖ Q)) then P,Q are prefixed by x,y respectively
% (Follows trivially from definition)

rec not_redex_prefs : (Ψ:ctx) [Ψ ⊢ not_redex (\x.P) (\y.Q)] → [Ψ ⊢ prefs (\x.P) (\y.Q)] =
  / total /
  fn nr ⇒ case nr of
  | [_ ⊢ nr/wait1] ⇒ [_ ⊢ prfs (\x.pref/wait) (\y.pref/wait)]
  | [_ ⊢ nr/wait2] ⇒ [_ ⊢ prfs (\x.pref/wait) (\y.pref/inp)]
  | [_ ⊢ nr/wait3] ⇒ [_ ⊢ prfs (\x.pref/wait) (\y.pref/out)]
  | [_ ⊢ nr/close1] ⇒ [_ ⊢ prfs (\x.pref/close) (\y.pref/close)]
  | [_ ⊢ nr/close2] ⇒ [_ ⊢ prfs (\x.pref/close) (\y.pref/inp)]
  | [_ ⊢ nr/close3] ⇒ [_ ⊢ prfs (\x.pref/close) (\y.pref/out)]
  | [_ ⊢ nr/inp1] ⇒ [_ ⊢ prfs (\x.pref/inp) (\y.pref/inp)]
  | [_ ⊢ nr/inp2] ⇒ [_ ⊢ prfs (\x.pref/inp) (\y.pref/wait)]
  | [_ ⊢ nr/inp3] ⇒ [_ ⊢ prfs (\x.pref/inp) (\y.pref/close)]
  | [_ ⊢ nr/out1] ⇒ [_ ⊢ prfs (\x.pref/out) (\y.pref/out)]
  | [_ ⊢ nr/out2] ⇒ [_ ⊢ prfs (\x.pref/out) (\y.pref/wait)]
  | [_ ⊢ nr/out3] ⇒ [_ ⊢ prfs (\x.pref/out) (\y.pref/close)]
  ;

% If NotRedex((νxy)(P ‖ Q)), then (νxy)(P ‖ Q) is not a redex
% (Follows trivially from definition)

rec redex_contra : (Ψ:ctx) [Ψ ⊢ not_redex (\x.P) (\y.Q)] → [Ψ ⊢ redex (\x.P) (\y.Q)] → [ ⊢ false] =
  / total /
  fn nr, r ⇒ case r of
  | [_ ⊢ rdx/close_wait] ⇒ impossible nr
  | [_ ⊢ rdx/wait_close] ⇒ impossible nr
  | [_ ⊢ rdx/out_inp] ⇒ impossible nr
  | [_ ⊢ rdx/inp_out] ⇒ impossible nr
  ;

% If (Δ, x :¹ T, y :¹ T^⊥) ⊢ (P ‖ Q), x ∉ fv(Q), and y ∉ fv(P),
% then (νxy)(P ‖ Q) is a redex

rec tp_safe_lemma : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
[Ψ,x:obj,y:obj ⊢ oft (cons (cons Δ[..] x T[] 𝟙) y T'[] 𝟙) (par P[..,x] Q[..,y])]
→ [Ψ,x:obj ⊢ pref x P] → [Ψ,y:obj ⊢ pref y Q] → [ ⊢ dual T T']
→ [Ψ ⊢ redex (\x.P) (\x.Q)] =
  / total /
  fn d, p1, p2, du ⇒
  let [_,x:obj,y:obj ⊢ oft/par D1 D2 (mg/c (mg/c M1 T1[]) T2[])] = d in
  let [ ⊢ mult/refl] = oft_notin_fv [_,x:obj,y:obj ⊢ D1] (refl_top [_,x:obj,y:obj ⊢ _] [_,x:obj,y:obj ⊢ _] [ ⊢ _] [ ⊢ _]) in
  let [ ⊢ mult/refl] = oft_notin_fv (oft_exch_top [_,x:obj,y:obj ⊢ D2[..,y,x]]) (refl_top [_,x:obj,y:obj ⊢ _] [_,x:obj,y:obj ⊢ _] [ ⊢ _] [ ⊢ _]) in
  let [ ⊢ •/10] = [ ⊢ T1] in
  let [ ⊢ •/01] = [ ⊢ T2] in
  let Prune-Merge [_,x:obj ⊢ M1'] [_,x:obj,y:obj ⊢ _] = prune_merge [_,x:obj,y:obj ⊢ M1] in
  let Prune-Merge [_ ⊢ M2] [_,x:obj ⊢ _] = prune_merge [_,x:obj ⊢ M1'] in
  case p1 of
  | [_,x:obj ⊢ pref/wait] ⇒
    let [_,x:obj,y:obj ⊢ oft/wait (upd/n U1) _] = [_,x:obj,y:obj ⊢ D1] in
    (case [_,x:obj,y:obj ⊢ U1] of
    | [_,x:obj,y:obj ⊢ upd/n U1'] ⇒ impossible upd_contra [_,x:obj,y:obj ⊢ U1'[..,y,x]]
    | [_,x:obj,y:obj ⊢ upd/t _] ⇒
      let [ ⊢ du/e1] = du in
      (case p2 of
      | [_,x:obj ⊢ pref/wait] ⇒
        let [_,x:obj,y:obj ⊢ oft/wait (upd/n (upd/n U2)) _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/close] ⇒ [_ ⊢ rdx/wait_close]
      | [_,x:obj ⊢ pref/inp] ⇒
        let [_,x:obj,y:obj ⊢ oft/inp (upd/n (upd/n U2)) \z. _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/out] ⇒
        let [_,x:obj,y:obj ⊢ oft/out U2a U2b _] = [_,x:obj,y:obj ⊢ D2] in
        (case [_,x:obj,y:obj ⊢ U2a] of
        | [_,x:obj,y:obj ⊢ upd/n (upd/n U2a')] ⇒
          let Prune-Upd [_,x:obj ⊢ U2a''] [_,x:obj,y:obj ⊢ _] = prune_upd [_,x:obj,y:obj ⊢ U2a'] in
          let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2a''] in
          let [_,x:obj,y:obj ⊢ upd/n (upd/n U2b')] = [_,x:obj,y:obj ⊢ U2b] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
        | [_,x:obj,y:obj ⊢ upd/t _] ⇒
          let [_,x:obj,y:obj ⊢ upd/n U2b'] = [_,x:obj,y:obj ⊢ U2b] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
        )
      )
    )
  | [_,x:obj ⊢ pref/close] ⇒
    let [_,x:obj,y:obj ⊢ oft/close (upd/n U1) _] = [_,x:obj,y:obj ⊢ D1] in
    (case [_,x:obj,y:obj ⊢ U1] of
    | [_,x:obj,y:obj ⊢ upd/n U1'] ⇒ impossible upd_contra [_,x:obj,y:obj ⊢ U1'[..,y,x]]
    | [_,x:obj,y:obj ⊢ upd/t _] ⇒
      let [ ⊢ du/e2] = du in
      (case p2 of
      | [_,x:obj ⊢ pref/wait] ⇒ [_ ⊢ rdx/close_wait]
      | [_,x:obj ⊢ pref/close] ⇒
        let [_,x:obj,y:obj ⊢ oft/close (upd/n (upd/n U2)) _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/inp] ⇒
        let [_,x:obj,y:obj ⊢ oft/inp (upd/n (upd/n U2)) \z. _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/out] ⇒
        let [_,x:obj,y:obj ⊢ oft/out U2a U2b _] = [_,x:obj,y:obj ⊢ D2] in
        (case [_,x:obj,y:obj ⊢ U2a] of
        | [_,x:obj,y:obj ⊢ upd/n (upd/n U2a')] ⇒
          let Prune-Upd [_,x:obj ⊢ U2a''] [_,x:obj,y:obj ⊢ _] = prune_upd [_,x:obj,y:obj ⊢ U2a'] in
          let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2a''] in
          let [_,x:obj,y:obj ⊢ upd/n (upd/n U2b')] = [_,x:obj,y:obj ⊢ U2b] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
        | [_,x:obj,y:obj ⊢ upd/t _] ⇒
          let [_,x:obj,y:obj ⊢ upd/n U2b'] = [_,x:obj,y:obj ⊢ U2b] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
        )
      )
    )
  | [_,x:obj ⊢ pref/inp] ⇒
    let [_,x:obj,y:obj ⊢ oft/inp (upd/n U1) \z. _] = [_,x:obj,y:obj ⊢ D1] in
    (case [_,x:obj,y:obj ⊢ U1] of
    | [_,x:obj,y:obj ⊢ upd/n U1'] ⇒ impossible upd_contra [_,x:obj,y:obj ⊢ U1'[..,y,x]]
    | [_,x:obj,y:obj ⊢ upd/t _] ⇒
      let [ ⊢ du/r _] = du in
      (case p2 of
      | [_,x:obj ⊢ pref/wait] ⇒
        let [_,x:obj,y:obj ⊢ oft/wait (upd/n (upd/n U2)) _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/close] ⇒
        let [_,x:obj,y:obj ⊢ oft/close (upd/n (upd/n U2')) _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2']
      | [_,x:obj ⊢ pref/inp] ⇒
        let [_,x:obj,y:obj ⊢ oft/inp (upd/n (upd/n U2)) \z. _] = [_,x:obj,y:obj ⊢ D2] in
        impossible upd_contra [_,x:obj,y:obj ⊢ U2]
      | [_,x:obj ⊢ pref/out] ⇒
        let [_,x:obj,y:obj ⊢ oft/out U2a U2b _] = [_,x:obj,y:obj ⊢ D2] in
        (case [_,x:obj,y:obj ⊢ U2a] of
        | [_,x:obj,y:obj ⊢ upd/n U2a'] ⇒
          let Prune-Upd [_,x:obj ⊢ _] [_,x:obj,y:obj ⊢ _] = prune_upd [_,x:obj,y:obj ⊢ U2a'] in
          [_ ⊢ rdx/inp_out]
        | [_,x:obj,y:obj ⊢ upd/t _] ⇒
          let [_,x:obj,y:obj ⊢ upd/n (upd/n U2b')] = [_,x:obj,y:obj ⊢ U2b] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
        )
      )
    )
  | [_,x:obj ⊢ pref/out] ⇒
    let [_,x:obj,y:obj ⊢ oft/out (upd/n U1a) (upd/n U1b) _] = [_,x:obj,y:obj ⊢ D1] in
    (case [_,x:obj,y:obj ⊢ U1a] of
    | [_,x:obj,y:obj ⊢ upd/n U1a'] ⇒
      let Prune-Upd [_,x:obj ⊢ U1a''] [_,x:obj,y:obj ⊢ _] = prune_upd [_,x:obj,y:obj ⊢ U1a'] in
      let Prune-Upd [_ ⊢ U1a'''] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U1a''] in
      (case [_,x:obj,y:obj ⊢ U1b] of
      | [_,x:obj,y:obj ⊢ upd/n U1b'] ⇒ impossible upd_contra [_,x:obj,y:obj ⊢ U1b'[..,y,x]]
      | [_,x:obj,y:obj ⊢ upd/t _] ⇒
        let [ ⊢ du/s DU] = du in
        (case p2 of
        | [_,x:obj ⊢ pref/wait] ⇒
          let [_,x:obj,y:obj ⊢ oft/wait (upd/n (upd/n U2)) _] = [_,x:obj,y:obj ⊢ D2] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2]
        | [_,x:obj ⊢ pref/close] ⇒
          let [_,x:obj,y:obj ⊢ oft/close (upd/n (upd/n U2')) _] = [_,x:obj,y:obj ⊢ D2] in
          impossible upd_contra [_,x:obj,y:obj ⊢ U2']
        | [_,x:obj ⊢ pref/inp] ⇒ [_ ⊢ rdx/out_inp]
        | [_,x:obj ⊢ pref/out] ⇒
          let [_,x:obj,y:obj ⊢ oft/out U2a U2b _] = [_,x:obj,y:obj ⊢ D2] in
          (case [_,x:obj,y:obj ⊢ U2a] of
          | [_,x:obj,y:obj ⊢ upd/n (upd/n U2a')] ⇒
            let Prune-Upd [_,x:obj ⊢ U2a''] [_,x:obj,y:obj ⊢ _] = prune_upd [_,x:obj,y:obj ⊢ U2a'] in
            let Prune-Upd [_ ⊢ _] [_,x:obj ⊢ _] = prune_upd [_,x:obj ⊢ U2a''] in
            let [_,x:obj,y:obj ⊢ upd/n (upd/n U2b')] = [_,x:obj,y:obj ⊢ U2b] in
            impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
          | [_,x:obj,y:obj ⊢ upd/t _] ⇒
            let [_,x:obj,y:obj ⊢ upd/n U2b'] = [_,x:obj,y:obj ⊢ U2b] in
            impossible upd_contra [_,x:obj,y:obj ⊢ U2b']
          )
        )
      )
    | [_,x:obj,y:obj ⊢ upd/t _] ⇒
      let [_,x:obj,y:obj ⊢ upd/n U1b'] = [_,x:obj,y:obj ⊢ U1b] in
      impossible upd_contra [_,x:obj,y:obj ⊢ U1b'[..,y,x]]
    )
  ;

% Corollary: If (Δ, x :¹ T, y :¹ T^⊥) ⊢ (P ‖ Q), x ∉ fv(Q), and y ∉ fv(P),
% then NotRedex((νxy)(P ‖ Q)) yields a contradiction 

rec tp_safe_lemma_cor : (Ψ:ctx) (Δ:[Ψ ⊢ lctx K[]])
[Ψ ⊢ not_redex (\x.P) (\y.Q)] 
→ [Ψ,x:obj,y:obj ⊢ oft (cons (cons Δ[..] x T[] 𝟙) y T'[] 𝟙) (par P[..,x] Q[..,y])]
→ [ ⊢ dual T T']
→ [ ⊢ false] =
  / total /
  fn nr, d, du ⇒
  let [_ ⊢ prfs (\x.P1) (\x.P2)] = not_redex_prefs nr in
  redex_contra nr (tp_safe_lemma d [_,x:obj ⊢ P1] [_,x:obj ⊢ P2] du)
  ;
